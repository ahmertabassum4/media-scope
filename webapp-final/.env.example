OPENROUTER_API_KEY=your-openrouter-key-here
BIAS_OPENROUTER_MODEL=openai/gpt-5.5
FACTUALITY_OPENROUTER_MODEL=openai/gpt-5.5
MAX_UPLOAD_MB=20
MODELS_API_URL=http://models:8001
MODELS_REQUEST_TIMEOUT_SECONDS=360
CORS_ORIGINS=*

# --- Game response logging -> private HF Dataset repo ---
# Set these as Space secrets/variables (not committed). If unset, answers are still
# written to a local CSV but not pushed anywhere.
HF_TOKEN=your-hf-write-token        # a Hugging Face token with WRITE access
GAME_DATASET_REPO=your-username/mediascope-game-responses
GAME_DATASET_PRIVATE=true
GAME_RESPONSES_PATH=/tmp/game_responses.csv
GAME_RESPONSES_FLUSH_EVERY=20       # commit after this many answers...
GAME_RESPONSES_FLUSH_INTERVAL=300   # ...or this many seconds, whichever comes first

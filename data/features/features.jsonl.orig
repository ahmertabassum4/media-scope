{"_key": "environmentaldefensefund", "source_key": "environmentaldefensefund", "filename": "Environmental_Defense_Fund.png", "image_file": "Environmental_Defense_Fund.png", "ok": true, "feature_schema": "nollm_raw12_v3_lx9_v8", "nollm_features": {"s004_sensational_verbs": 0.0, "s008_neutral_headlines": 0.0, "s010_scare_quotes": 1.0, "s023_no_owner_identified": 1.0, "s072_loaded_category_tags": 1.0, "s076_conspiracy_tropes": 0.0, "s078_absolutist_framing": 2.0, "s085_standard_sections": 4.0, "s097_suspicious_url": 0.0, "story_block_count": 34.0, "hero_image_area_frac": 0.01387, "thumbnail_size_uniformity": 0.7886, "s060_templated_imagery": 0.0, "largest_face_area_frac": 0.0012, "small_face_count": 1.0, "s066_cluttered_blog_look": 0.0524, "inter_story_whitespace_frac": 0.295, "content_column_count": "1", "side_margin_frac": 0.092, "header_band_height_frac": 0.0081, "logo_centered": 1.0, "accent_hue": "blue", "accent_color_count": 3.2935, "background_brightness": "white", "s067_alarmist_colors": 0.0362, "page_scroll_length": "medium", "nav_item_count": 29.0, "footer_link_count": 68.0, "cta_button_count": 4.0, "newsletter_box_count": 1.0, "social_icon_count": 0.0, "search_box_present": 0.0, "weather_widget_present": 0.0, "account_button_present": 0.0, "category_badge_count": 9.0, "mean_headline_word_count": 4.125, "headline_size_variance": 0.3299, "page_text_density": "medium", "timestamp_count": 1.0, "allcaps_token_frac": 0.0421, "number_token_frac": 0.0396, "city_or_county_in_name": 0.0, "lx_ideology_identity_per100": 0.0, "lx_attribution_per100": 0.0, "lx_timestamp_per100": 0.241, "lx_loaded_outgroup_per100": 0.0, "lx_health_scare_per100": 0.4819, "lx_question_style_per100": 3.3735, "lx_culture_war_per100": 0.241, "lx_market_money_per100": 0.0, "lx_local_civic_per100": 0.0}, "ocr_text": "iy j \\ Triple your impact to protect our planet Help cut the pollution that causes climate change to protect what matters most \u2014 people and the planet. Donate today and your gi